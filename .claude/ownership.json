{
  "_doel": "Machineleesbare eigendomskaart voor parallel-check.mjs. De leesbare versie staat in CLAUDE.md onder '## Module ownership'. Wijzig ze samen.",
  "bestand": "index.html",

  "_signalen": "Regex op de naam van een anker (functie, const, of CSS-selector). Een anker zonder signaal erft het spoor van zijn buren; erven de buren verschillend, dan blijft het 'onbekend' en wordt elke wijziging eraan gemeld.",
  "sporen": {
    "dashboard": {
      "titel": "Dashboard",
      "html": "mod-dashboard",
      "signalen": ["^dash", "^[.]dash-", "Dashboard"]
    },
    "notes": {
      "titel": "Notities",
      "html": "mod-notes",
      "signalen": ["^note", "^[.]note", "Note(?!rmaal)", "Notes", "notesState"]
    },
    "checklist": {
      "titel": "Checklist",
      "html": "mod-checklist",
      "signalen": ["^cl[A-Z0-9]", "^[.]cl-", "^[.]cl2-", "Checklist", "Subtask", "Subtaak", "checklistState"]
    },
    "uren": {
      "titel": "Uren",
      "html": "mod-uren",
      "signalen": ["^uren", "^_uren", "^[.]uren-", "Uren", "urenState"]
    },
    "facturen": {
      "titel": "Facturen",
      "html": "mod-facturen",
      "signalen": ["^fac", "^_fac", "^factuur", "^[.]fac-", "Factuur", "Facturen", "Debiteur", "factuurState"]
    }
  },

  "_niet_verdeeld": "mod-todo (Kanban) heeft te weinig eigen code voor een eigen spoor; die regio valt onder de coordinator.",
  "coordinatorRegios": ["mod-todo"],

  "_gedeeld": "Raakt een spoor hier iets, dan is dat geen fout maar een contractwijziging: melden, niet zelf doorvoeren.",
  "gedeeld": {
    "functies": [
      "hydrateerState", "verzamelModuleState", "huidigeStateSnapshot",
      "updateNavBadges", "renderAll", "saveLocalBackup", "loadLocalBackup",
      "zetModalSluitknoppen", "saveGist", "saveGistIntern", "loadGist",
      "refreshGist", "scheduleSave", "appToast", "setSync", "geheimenKlaar",
      "autoSyncKijk", "autoSyncVeilig", "escapeHtml", "dateStr", "isoDate",
      "cijfersOpen", "toonModule", "route", "renderClientChips"
    ],
    "selectors": [
      ":root", ".modal", ".modal-bg", ".modal-footer", ".btn", ".btn-sm",
      ".btn-primary", ".btn-danger", ".toast", ".nav", ".nav-item", ".mod-",
      ".icoon-meer", ".client-filter", ".module", ".module-topbar", ".module-title",
      ".uren-btn", ".uren-btn-bedrijf", ".uren-btn-icon", ".uren-btn-lab",
      ".uren-btn-primary", ".uren-btn-vandaag", ".uren-chip", ".uren-chip-clear",
      ".uren-content", ".uren-date-row", ".uren-dur", ".uren-dur-btn",
      ".uren-dur-chips", ".uren-dur-in", ".uren-empty", ".uren-fab", ".uren-fchip",
      ".uren-filterpop", ".uren-filters", ".uren-fld", ".uren-form", ".uren-kpi",
      ".uren-kpi-lab", ".uren-kpi-sub", ".uren-kpi-val", ".uren-kpis",
      ".uren-mcard", ".uren-menu", ".uren-menu-item", ".uren-menu-sep",
      ".uren-periode", ".uren-periode-lbl", ".uren-scope", ".uren-scope-pop",
      ".uren-sheet-card", ".uren-tab", ".uren-tabs", ".uren-topbar",
      ".uren-topbar-title", ".uren-topbar-vul", ".uren-topfilter", ".uren-viewbar"
    ],
    "_selectors_toelichting": "De 42 .uren-* regels hieronder worden door Facturen hergebruikt (gemeten: 150+ voorkomens in de facturenregio). Ze horen bij niemand: wie ze wijzigt, wijzigt twee modules.",
    "bestanden": [
      "sw.js", "manifest.json", "validate.mjs", "test.html", "CLAUDE.md",
      "docs/decisions.md", "docs/stijlgids.md", "docs/mobile.md",
      "parallel-check.mjs", ".claude/ownership.json", ".claude/settings.json"
    ]
  },

  "_stijlprobe": "Selectors waarvan parallel-check.mjs de berekende stijl voor en na de merge vergelijkt.",
  "stijlProbe": {
    "combinaties": [
      { "naam": "desktop-licht", "breedte": 1400, "thema": "light" },
      { "naam": "desktop-donker", "breedte": 1400, "thema": "dark" },
      { "naam": "mobiel-licht", "breedte": 375, "thema": "light" },
      { "naam": "mobiel-donker", "breedte": 375, "thema": "dark" }
    ],
    "eigenschappen": [
      "height", "min-height", "padding", "margin", "font-size", "font-weight",
      "line-height", "color", "background-color", "border", "border-radius",
      "display", "gap", "width", "max-width", "grid-template-columns", "flex-direction"
    ]
  }
}
